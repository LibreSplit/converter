	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug convert integration tests",
			"type": "lldb",
			"request": "launch",
			"cargo": {
				"args": [
					"test",
					"--no-run",
					"--test",
					"convert",
					"--package",
					"converter"
				],
				"filter": {
					"name": "convert",
					"kind": "test"
				}
			},
			"args": ["--no-capture"],
			"cwd": "${workspaceFolder}",
			"sourceLanguages": ["rust"],
			"console": "integratedTerminal"
		}
	]
}